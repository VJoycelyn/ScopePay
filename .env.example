# ScopePay prototype: never commit credentials or use real client data.
# PayPal Developer Dashboard > Sandbox REST API app only, same app for both.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional exact public HTTPS origin for PayPal return/cancel URLs; defaults to this project's host.
SCOPEPAY_PUBLIC_ORIGIN=

# Managed WebDev supplies MySQL and AI runtime variables automatically.
# For authorized self-hosted use, provide these through your secret manager.
DATABASE_URL=
MANUS_API_URL=
MANUS_API_KEY=

# The project also supports the platform's legacy AI runtime aliases:
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Optional local runtime settings (defaults shown; not credentials).
PORT=3000
